# PenDrops Environment Configuration
# Copy to .env and fill in production values
# Never commit .env with real secrets!

# Admin PIN for the teacher cabinet unlock step
VITE_ADMIN_PIN=6137

# Supabase project credentials (https://supabase.com dashboard)
# Get these from: https://supabase.com/dashboard/project/_/settings/api-keys
VITE_SUPABASE_URL=your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Supabase Storage bucket name for the schedule file
VITE_SUPABASE_BUCKET=schedule

# Path to the encrypted admin credential file inside the bucket
VITE_ADMIN_CREDENTIAL_PATH=admin_credential.enc

# Teacher PWA storage buckets
VITE_TEACHER_BUCKET=teacher_homework
VITE_SUBMISSIONS_BUCKET=teacher_submissions
VITE_PROFILES_BUCKET=teacher_profiles
VITE_STUDENT_PHOTOS_BUCKET=student_photos

# Supabase direct PostgreSQL connection (for Management API operations)
# Uses the Supabase connection pooler for better network compatibility
# These are used by scripts/supabase-db.mjs for direct SQL operations
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_HOST=your-project-ref.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.your-project-ref

# Deprecated: GitHub repository variables (kept for backwards compatibility during migration)
# VITE_GITHUB_REPO=telikuy070-collab/pendrops
# VITE_GITHUB_BRANCH=main
